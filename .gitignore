node_modules/
dist/
dist-assets/

# 원본 ROM·추출물. 리포에 절대 들어가면 안 된다 (§14.1) — 롬 1개가 128MB다
raw/

# raw/ + tools/ 파이프라인으로 재생성되는 산출물. 최종적으로는 R2에서 서빙한다 (§4.6)
public/models/
# 청크 모델 28MB + 소품 2.5MB + 맵 텍스처 0.6MB.
# `pnpm extract:chunks && pnpm extract:props && pnpm extract:mapTextures`로 만든다
public/data/chunks/
public/data/props/
public/data/tex/
# 소리 7.5MB — 악보 1013 · 악기표 521 · 파형 창고 521.
# `pnpm extract:sound`로 만든다. index.json은 작아서 추적한다
public/data/sound/seq/
public/data/sound/bnk/
public/data/sound/war/
*.nds
*.sdat
*.local
.DS_Store
tools/spike/*.cpp
tools/spike/*.h

# BDSP 추출 산출물 (raw/ 하위지만 명시해 둔다)
raw/models/*/baked/

# tsc -b 캐시. 빌드 산출물이라 추적하지 않는다
tsconfig.tsbuildinfo

# 오프라인 렌더러가 굽는 확인용 그림. 산출물이 아니라 눈으로 보려고 만드는 것이다
chunk-*.png
town-*.png

# 파이썬 바이트코드. 도구를 돌리면 생긴다
__pycache__/
