node_modules/
dist/
dist-assets/

# 원본 ROM·추출물. 리포에 절대 들어가면 안 된다 (§14.1) — 롬 1개가 128MB다
raw/

# raw/ + tools/ 파이프라인으로 재생성되는 산출물. R2에서 서빙한다 (§4.6, COPYRIGHT.md §5)
#
# ⚠️ **폴더째다. 목차만 남기는 예외를 안 둔다.** 두려고 로더가 첫 왕복에 읽는 것을
# 재 봤더니 16개 2.6MB였고, 그 안에 `matrices/0.bin`(1.8MB, 신오 전체 배치)과
# `encounters.json`(254KB)이 있었다 — 저작권 축에서 빼려던 바로 그것이라 예외가
# 성립하지 않는다. 목차 노릇은 `assets-manifest.json`이 대신한다.
#
# 없을 때 무엇을 돌려야 하는지는 `pnpm assets:check`가 그룹별로 찍어 준다.
public/models/
public/data/
*.nds
*.sdat
*.local
.DS_Store
tools/spike/*.cpp
tools/spike/*.h

# BDSP 추출 산출물 (raw/ 하위지만 명시해 둔다)
raw/models/*/baked/

# tsc -b 캐시. 빌드 산출물이라 추적하지 않는다
tsconfig.tsbuildinfo

# 오프라인 렌더러가 굽는 확인용 그림. 산출물이 아니라 눈으로 보려고 만드는 것이다
chunk-*.png
town-*.png

# 파이썬 바이트코드. 도구를 돌리면 생긴다
__pycache__/
