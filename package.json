    "extract:boxWallpapers": "node tools/extract/boxWallpapers.js",
    "extract:townMap": "node tools/extract/townMap.js",
    "extract:signposts": "node tools/extract/signposts.js",
    "extract:chunks": "node tools/extract/chunks.js",
    "extract:mapTextures": "node tools/extract/mapTextures.js",
    "extract:props": "node tools/extract/props.js",
    "extract:starterScene": "node tools/extract/starterScene.js",
    "extract:spawns": "node tools/extract/spawns.js",
    "extract:npcModels": "node --experimental-strip-types tools/extract/npcModels.mjs",
    "extract:marts": "node tools/extract/marts.js",
    "extract:sndTables": "node tools/extract/sndTables.js",
    "release:check": "node tools/distribution/check.mjs --stage=post --release",
    "provenance": "node tools/distribution/reportProvenance.mjs",
    "verify:deploy": "node tools/distribution/verifyDeploy.mjs",
    "audit:history": "node tools/distribution/auditHistory.mjs",
    "check:worker": "node tools/shot/workerCheck.mjs",
    "e2e": "node tools/e2e/run.mjs",
    "bake:mechanics": "node tools/distribution/mechanics/bake.mjs",
