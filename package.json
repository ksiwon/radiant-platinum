    "extract:pokegra": "node tools/extract/pokegra.js",
    "extract:trainerSprites": "node tools/extract/trainerSprites.js",
    "extract:sound": "node tools/extract/sound.js",
    "extract:encounters": "node tools/extract/encounters.js",
    "extract:trainers": "node tools/extract/trainers.js",
    "extract:bdhc": "node tools/extract/bdhc.js",
    "extract:scripts": "node tools/extract/scripts.js",
    "verify:scripts": "node tools/extract/scripts-verify.js",
    "extract:dialogue": "node tools/extract/dialogue.js",
    "verify:dialogue": "node tools/extract/dialogue-verify.js",
    "extract:textbanks": "node tools/extract/textbanks.js",
    "extract:items": "node tools/extract/items.js",
    "extract:hiddenItems": "node tools/extract/hiddenItems.js",
    "extract:berries": "node tools/extract/berries.js",
    "extract:distortion": "node tools/extract/distortion.js",
    "extract:pokedexSort": "node tools/extract/pokedexSort.js",
    "extract:pokedexHabitat": "node tools/extract/pokedexHabitat.js",
