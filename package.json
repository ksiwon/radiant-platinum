    "extract:moves": "node tools/extract/moves.js",
    "extract:headers": "node tools/extract/headers.js",
    "extract:matrices": "node tools/extract/matrices.js",
    "extract:events": "node tools/extract/events.js",
    "verify:events": "node tools/extract/events-verify.js",
